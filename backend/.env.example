# =============================================================================
# SPANDANA Server — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env — this file is safe to commit (no real secrets)
# =============================================================================

# MongoDB connection string (Atlas recommended for production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/spandana?retryWrites=true&w=majority

# JWT secret — use a long random string in production (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string

# Server port
PORT=4000

# CORS origin — must match your frontend URL (Vercel URL in production)
CORS_ORIGIN=https://your-app.vercel.app

# Environment
NODE_ENV=production
