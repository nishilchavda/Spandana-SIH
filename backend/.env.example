# =============================================================================
# SPANDANA Server — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# MongoDB connection string (local or Atlas)
# Local:
# MONGODB_URI=mongodb://localhost:27017/spandana
# Atlas (production):
MONGODB_URI=mongodb+srv://nishilchavda:Nishil6990@nishilcluster.itoulbc.mongodb.net/spandana?retryWrites=true&w=majority&appName=nishilcluster

# JWT secret — use a long random string in production
JWT_SECRET=spandana_dev_secret_change_in_prod

# Server port
PORT=4000

# CORS origin — must match your Next.js dev URL
CORS_ORIGIN=http://localhost:3000
